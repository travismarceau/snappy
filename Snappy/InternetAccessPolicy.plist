<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Internet Access Policy (Little Snitch and similar tools read this).

	Snappy makes exactly one kind of connection: Sparkle fetching the appcast to
	see whether a newer version exists, and then the update itself. Nothing else
	leaves the machine — no analytics, no crash reporting, no remote config.

	Rectangle, which Snappy derives from, declared this against rectangleapp.com.
	Snappy polls its own host.
-->
<plist version="1.0">
<dict>
	<key>ApplicationName</key>
	<string>Snappy</string>
	<key>ApplicationDescription</key>
	<string>Snappy is Divvy-style window placement for macOS. Free and open source.</string>
	<key>Connections</key>
	<array>
		<dict>
			<key>IsIncoming</key>
			<false/>
			<key>Host</key>
			<string>getsnappy.fyi</string>
			<key>NetworkProtocol</key>
			<string>TCP</string>
			<key>Port</key>
			<string>443</string>
			<key>Purpose</key>
			<string>Snappy checks for new versions and downloads them</string>
			<key>DenyConsequences</key>
			<string>If you deny this connection, Snappy keeps working but will never tell you a new version exists. You would need to check getsnappy.fyi yourself.</string>
		</dict>
	</array>
</dict>
</plist>
